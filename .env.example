# ---------------------------------------------------------------------------
# AutoMail — environment configuration
# Copy to `.env` (`cp .env.example .env`) and fill in the values you have.
#
# The app boots with an empty file and shows a setup checklist on the
# dashboard. MOCK_MAIL=true gives you a built-in fixture mailbox so the whole
# pipeline and every page can be exercised before any Google credentials
# exist. Gemini is optional too: without a key the pipeline still runs, but
# every email that no rule matched is sent to "Needs attention" instead of
# being classified.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Port the Next.js server listens on inside the container.
PORT=3000
NODE_ENV=production
# Public origin, used for absolute URLs and the OAuth redirect. No trailing slash.
NEXT_PUBLIC_APP_URL=https://automail.example.com
# IANA timezone that defines "today" for the daily cap and the run times.
APP_TIMEZONE=Europe/London

# --- Database (SQLite via Prisma) -----------------------------------------
# Absolute path in Docker where /app/data is a mounted volume.
DATABASE_URL="file:/app/data/automail.db"
# For local development, prefer:
# DATABASE_URL="file:./dev.db"

# --- Dashboard access ------------------------------------------------------
# Recommended: Sign in with Google. Only the addresses listed here may open
# the dashboard (comma separated). Needs the Google OAuth client below.
DASHBOARD_ALLOWED_EMAILS=you@gmail.com
# Optional password fallback. Leave empty in production once Google sign-in
# works; while empty, password sign-in is disabled entirely.
DASHBOARD_PASSWORD=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Days a sign-in lasts before Google (or the password) is asked again.
SESSION_TTL_DAYS=30
# Encrypts Gmail refresh tokens at rest (AES-256-GCM). Generate the same way.
# Losing this key means reconnecting every account; back it up with .env.
TOKEN_ENCRYPTION_KEY=
# Optional. Bearer token for POST /api/jobs/run if you drive runs from cron
# instead of the built-in scheduler.
CRON_SECRET=

# --- Google OAuth / Gmail API ---------------------------------------------
# https://console.cloud.google.com — see DEPLOYMENT.md § Google Cloud setup.
#   1. Create a project and enable the "Gmail API".
#   2. OAuth consent screen: External, add the gmail.modify scope, add each
#      Gmail address you will connect as a test user, then publish the app
#      (an app left in "Testing" gets refresh tokens that expire every 7 days).
#   3. Credentials -> OAuth client ID -> Web application, with BOTH redirect
#      URIs (mailbox connection and dashboard sign-in):
#        https://YOUR_DOMAIN/api/google/callback
#        https://YOUR_DOMAIN/api/auth/google/callback
#      (plus the http://localhost:3000/... equivalents for local development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://automail.example.com/api/google/callback

# --- Google Gemini ---------------------------------------------------------
# https://aistudio.google.com/apikey
# Enable billing on the project: on the free tier Google may use prompts to
# improve its products, which you do not want for personal email.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# USD per million tokens for the model above. Editable later in Settings;
# they only seed the first boot. Used to compute the cost figures shown on
# the dashboard from the real token counts Gemini reports.
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50

# --- Processing defaults ---------------------------------------------------
# These seed the Settings page on first boot. Change them there afterwards;
# the values here are ignored once the database holds a setting.
#
# Every setting belongs to one mailbox. These values seed each newly connected
# mailbox, which is then configured on its own from Settings (and its "About
# you" profile from Rules), with the mailbox chosen in the top-right switcher.
# A personal address and a work address never share a setting.
#
# Emails touched per day, per mailbox (rule hits count).
DAILY_EMAIL_LIMIT=100
# Emails per Gemini request. The profile and rules are paid for once per batch.
AI_BATCH_SIZE=10
# Characters of body text sent to the model per email.
MAX_BODY_CHARS=1500
# Scheduled run times (24h, APP_TIMEZONE), comma separated.
RUN_TIMES=07:00,19:00
# Extra polling for the new-mail lane only, in minutes. 0 disables.
NEW_MAIL_POLL_MINUTES=0
# Decide and log but never touch Gmail. Each mailbox is switched
# over on its own from Settings, so you can trust one before the others.
DRY_RUN=true
# Backlog order: newest | oldest
BACKLOG_ORDER=newest
# Gmail search that defines the backlog for a newly connected
# mailbox. Default: everything received.
BACKLOG_QUERY="-in:spam -in:trash -in:sent -in:drafts -in:chats"
# Parent label under which category labels are created, e.g. AutoMail/Finance.
LABEL_PREFIX=AutoMail
# Auto-trash (rules with autoApply, categories with autoTrash) only fires at or
# above this confidence. Everything below is queued for review.
AUTO_TRASH_MIN_CONFIDENCE=90
# Set to false when a host cron calls /api/jobs/run instead.
SCHEDULER_ENABLED=true
# true = use the built-in fixture mailbox instead of Google. No credentials needed.
MOCK_MAIL=false
